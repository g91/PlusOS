{
 "format": "plusui-1",
 "app": "uidemo",
 "forms": [
  {
   "name": "main",
   "title": "PlusUI Demo",
   "w": 400,
   "h": 232,
   "pos": "center",
   "menus": [
    {
     "title": "File",
     "items": [
      "About...",
      "-",
      "Quit^Q"
     ]
    },
    {
     "title": "Dialogs",
     "items": [
      "Message Box",
      "Ask a Question",
      "Input Box"
     ]
    }
   ],
   "timer": 60,
   "events": [
    "close",
    "timer"
   ],
   "widgets": [
    {
     "kind": "tabs",
     "name": "tabs",
     "x": 8,
     "y": 4,
     "w": 384,
     "h": 192,
     "items": [
      "Controls",
      "Text",
      "Extras"
     ],
     "value": 0,
     "events": []
    },
    {
     "kind": "group",
     "name": "grpOptions",
     "x": 20,
     "y": 28,
     "w": 136,
     "h": 84,
     "text": "Options",
     "events": [],
     "tabs": "tabs",
     "tab_page": 0
    },
    {
     "kind": "checkbox",
     "name": "chkSound",
     "x": 28,
     "y": 42,
     "w": 120,
     "h": 14,
     "text": "Sound",
     "checked": true,
     "events": [
      "change"
     ],
     "tabs": "tabs",
     "tab_page": 0
    },
    {
     "kind": "checkbox",
     "name": "chkTurbo",
     "x": 28,
     "y": 58,
     "w": 120,
     "h": 14,
