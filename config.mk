# PlusOS build configuration ------------------------------------------------
# Paths are as seen from WSL (Ubuntu). build.bat runs make inside WSL.

# Target Hardware Architecture & Machine:
#   MACHINE ?= se
# Supported targets:
#   universal - ONE image that boots on ANY supported Mac. Like classic Mac OS, the
#               boot block and kernel are processor-independent and detect the
#               CPU/machine at run time (CPUFlag at $12F, ROM version), so the
#               same binary adapts to a 68000 Plus/SE/Classic or a 68030 LC III.
#   se      - Macintosh SE (Motorola 68000 @ 8 MHz, ADB, 512x342) [Default]
#   plus    - Macintosh Plus (Motorola 68000 @ 8 MHz, Serial Keyboard, 512x342)
#   classic - Macintosh Classic (Motorola 68000 @ 8 MHz, ADB, 512x342)
#   lc3     - Macintosh LC III / LC III+ (Motorola 68030 @ 25/33 MHz, 32-bit bus, 640x480)
MACHINE ?= se

ifeq ($(MACHINE),universal)
  # Universal image: -m68000 code runs on every 680x0; the kernel detects the
  # CPU at run time. The boot block uses the minimal ROM-independent loader
  # (works on all machines, including the LC III - the kernel flushes the 68030
  # caches itself in crt0). Screen defaults are the safe compact-Mac values;
  # the LC III path auto-detects its 640x480 framebuffer at run time.
  ARCH_FLAGS := -m68000
  PLUSOS_MACHINE_CPPFLAGS := -DTARGET_UNIVERSAL -DPLUSOS_MACHINE_UNIVERSAL -DFB_DEFAULT_WIDTH=512 -DFB_DEFAULT_HEIGHT=342 -DFB_DEFAULT_ROWBYTES=64
else ifeq ($(MACHINE),lc3)
  ARCH_FLAGS := -m68030
  PLUSOS_MACHINE_CPPFLAGS := -DTARGET_MACLC3 -DPLUSOS_MACHINE_LC3 -DFB_DEFAULT_WIDTH=640 -DFB_DEFAULT_HEIGHT=480 -DFB_DEFAULT_ROWBYTES=80
else ifeq ($(MACHINE),classic)
  ARCH_FLAGS := -m68000
  PLUSOS_MACHINE_CPPFLAGS := -DTARGET_MACCLASSIC -DPLUSOS_MACHINE_CLASSIC -DFB_DEFAULT_WIDTH=512 -DFB_DEFAULT_HEIGHT=342 -DFB_DEFAULT_ROWBYTES=64
else ifeq ($(MACHINE),plus)
  ARCH_FLAGS := -m68000
  PLUSOS_MACHINE_CPPFLAGS := -DTARGET_MACPLUS -DPLUSOS_MACHINE_PLUS -DFB_DEFAULT_WIDTH=512 -DFB_DEFAULT_HEIGHT=342 -DFB_DEFAULT_ROWBYTES=64
else
  # Default: Macintosh SE
  ARCH_FLAGS := -m68000
  PLUSOS_MACHINE_CPPFLAGS := -DTARGET_MACSE -DPLUSOS_MACHINE_SE -DFB_DEFAULT_WIDTH=512 -DFB_DEFAULT_HEIGHT=342 -DFB_DEFAULT_ROWBYTES=64
endif

# The two SDKs (separate, self-contained libraries, generated by tools/sdkgen):
#   sdks/macplus  Macintosh Plus SDK  <plusrom/...>  libplusrom.a
#   sdks/macse    Macintosh SE SDK    <serom/...>    libserom.a
# The kernel runs on both machines and builds with the Mac Plus SDK (the SE ROM
# contains every Plus trap); it also links the SE SDK's call catalog.
SDK_PLUS := $(abspath sdks/macplus)
SDK_SE   := $(abspath sdks/macse)

# Portable toolchain auto-detection — works on MSYS2 (Windows), native Linux, WSL.
# Search order (first match wins):
#   1. Local Retro68 built by tools/winbuild/setup.ps1  (MSYS2 path: /c/.../toolchain)
#   2. Current user's home Retro68 build
#   3. System-wide /usr/local/retro68
#   4. Any Windows user home found under /mnt/c/ (WSL) or /c/ (MSYS2)
_LINUX_USER := $(shell id -un 2>/dev/null)
_LOCAL_TC   := $(CURDIR)/tools/winbuild/toolchain
_WIN_TC_WSL := $(firstword $(wildcard /mnt/c/Users/*/Retro68-build/toolchain))
_WIN_TC_M2  := $(firstword $(wildcard /c/Users/*/Retro68-build/toolchain))
TOOLCHAIN ?= $(firstword $(wildcard \
    $(_LOCAL_TC) \
    /home/$(_LINUX_USER)/Retro68-build/toolchain \
    /usr/local/retro68 \
    $(_WIN_TC_WSL) \
    $(_WIN_TC_M2) \
))
ifneq ($(TOOLCHAIN),)
  CROSS   ?= $(TOOLCHAIN)/bin/m68k-apple-macos-
else
  CROSS   ?= $(or $(firstword $(foreach p,m68k-apple-macos- m68k-elf- m68k-linux-gnu-,$(if $(shell command -v $(p)gcc 2>/dev/null),$(p)))),m68k-apple-macos-)
endif

# kernel extra library: the SE SDK's ROM catalog (serom_find_call)
PLUSOS_EXTRA_LIBS := $(SDK_SE)/build/lib/libserom.a
PLUSOS_SDK := $(SDK_PLUS)
-include $(SDK_PLUS)/sdk.mk

# Upstream Macintosh ROM Assembly Sources:
# Repository: https://github.com/jonathanschilling/mac_rom
# Checks in-tree clone, sibling folder, or external mount
_WIN_MACROM_WSL := $(firstword $(wildcard /mnt/c/Users/*/PlusOS/mac_rom))
_WIN_MACROM_M2  := $(firstword $(wildcard /c/Users/*/PlusOS/mac_rom))
MACROM ?= $(firstword $(wildcard \
    $(CURDIR)/mac_rom \
    $(CURDIR)/../mac_rom \
    /mnt/f/mac_rom \
    /f/mac_rom \
    $(_WIN_MACROM_WSL) \
    $(_WIN_MACROM_M2) \
))
ifeq ($(MACROM),)
  MACROM    := $(CURDIR)/mac_rom
endif
_WIN_MULTI_WSL  := $(firstword $(wildcard /mnt/c/Users/*/Retro68/multiversal))
_WIN_MULTI_M2   := $(firstword $(wildcard /c/Users/*/Retro68/multiversal))
MULTIVERSAL ?= $(firstword $(wildcard \
    $(CURDIR)/multiversal \
    /home/$(_LINUX_USER)/Retro68/multiversal \
    $(_WIN_MULTI_WSL) \
    $(_WIN_MULTI_M2) \
))

# Universal & Portable Disk Images:
# Checks self-contained images/ directory inside PlusOS, and also writes to
# external BlueSCSI SD card (F: = /mnt/f) if attached.
IMAGE_LOCAL := $(CURDIR)/images/PlusOS.hda
SDCARD      ?= /mnt/f
IMAGE_REAL  ?= $(SDCARD)/HD60_512 PlusOS.hda
IMAGE_TEST  ?= $(SDCARD)/BOOTTEST.hda

# Disk layout (512-byte blocks, relative to the start of the HFS partition)
KERNEL_BLOCK  := 60000      # kernel image (raw), loaded by the boot block
KERNEL_BLOCKS := 512        # max kernel size: 512 * 512 = 256 KB (safe margin below BufPtr)
APPS_BLOCK    := 61000      # raw app store (fallback when HFS loading is unavailable)
