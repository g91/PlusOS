// sdktest.cpp - the @MACHINE@ SDK headers must also work from C++.
#include <@prefix@/@prefix@.h>
#include <plusos/plusos.h>

struct Box {
    Rect r;
    explicit Box(short t, short l, short b, short rt) : r{t, l, b, rt} {}
    virtual ~Box() {}
    virtual void draw() const { FrameRect(&r); }
};

int sdk_cxx_test()
{
    Box *b = new Box(1, 2, 3, 4);
    b->draw();
    delete b;
    return @prefix@_trap_in_rom(@PREFIX@_TRAP_InitGraf);
}
